# Backend configuration. The server reads process.env directly.
PORT=8787
# Recommended for this project: Supabase Session Pooler (copy the real URL from Supabase → Connect).
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
PGSSL=on
# Local PostgreSQL alternative:
# DATABASE_URL=postgresql://user:password@localhost:5432/damnoi
# PGSSL=off
ANTHROPIC_API_KEY=sk-ant-...
TOKI_MODEL=claude-haiku-4-5-20251001
# Phase 1 Classroom: long random secret used to sign teacher/student sessions.
AUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=southeastasia
AZURE_SPEECH_VOICE=en-US-SaraNeural

# Phase 0: transcripts below this Azure confidence are NOT sent to Claude.
# Tune from pilot data; 0.55 is the initial default.
STT_CONFIDENCE_THRESHOLD=0.55

# Existing app limits
DAILY_TURN_LIMIT=40

# Phase 4.1 Pilot Hardening — mission generator cost guards.
# Per-teacher server-side limits. Requests are serialized in Postgres so two
# simultaneous clicks cannot bypass the quota.
AI_MISSION_GEN_HOURLY_LIMIT=10
AI_MISSION_GEN_DAILY_LIMIT=30
AI_MISSION_GEN_CACHE_MINUTES=5

# Optional AI cost estimate for /api/admin/pilot. Set these to your CURRENT
# provider rates in USD per 1,000,000 tokens. Leave at 0 to log tokens/latency
# without displaying a potentially stale dollar estimate.
AI_INPUT_COST_PER_MTOK=0
AI_OUTPUT_COST_PER_MTOK=0

# Founder-only aggregate pilot metrics endpoint: /api/admin/pilot?key=...&days=7
ADMIN_KEY=replace-with-a-long-random-founder-key
# Abort slow Anthropic calls so a pilot session does not hang indefinitely.
AI_TIMEOUT_MS=25000

# Phase 5.1 — optional production CORS allowlist for the two frontend products.
# Leave empty during local development if preferred.
# CORS_ORIGINS=https://speaking.example.com,https://edu.example.com
