+  { lv: 5, icon: "👑",  name: "Huyền Thoại",desc: "Không ai qua được",   min: 60 },
+];
+const getLevel = (sessions = 0) => {
+  for (let i = LEVELS.length - 1; i >= 0; i--) {
+    if (sessions >= LEVELS[i].min) return LEVELS[i];
+  }
